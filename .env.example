# Local settings for Map Vietnam. Nothing here is needed to run it. Copy this file to .env
# and fill in what you want; Map Vietnam also writes .env for you (readable by you only) if
# you ever give it a Kaggle key, in the map viewer or with "python3 start.py setup --only thor".
# Never commit .env: it is in .gitignore. A variable set in the environment wins over .env.

# Kaggle account name and API key, for the THOR air strike records. Kaggle currently gives
# that file without a key, so leave these empty; if it ever asks for one, Map Vietnam says so.
# Then get them free: kaggle.com -> your picture -> Settings -> API -> "Create Legacy API Key"
# (older pages call it "Create New Token");
# the kaggle.json it downloads holds "username" and "key". Instead of setting these you can
# leave that kaggle.json in ~/.kaggle/ (or in the folder named by KAGGLE_CONFIG_DIR).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: an e-mail address or web page added to the User-Agent of every download
# ("MapVietnam/0.1 (+https://github.com/CaullenOmdahl/map-vietnam; historical map research; low-volume; <this>)"), so the operators of the
# archives this tool reads can contact whoever runs this copy. Left empty, none is sent.
MAPVIETNAM_CONTACT=

# Optional: connect this copy to a shared Map Vietnam Hub server (for example on Railway) to stream
# infinitely cached maps, bare-earth terrain, LiDAR canopy, and keyed archives, or to cache your
# locally built and placed maps back up to the server.
HUB_URL=
HUB_API_KEY=
HUB_AUTO_PUSH=false

# Optional (Hub Server on Railway / Docker): set ONE admin password in Railway's environment
# variables (`HUB_ADMIN_PASSWORD`), then connect from the Map Vietnam desktop app using your
# server's domain or IP address + this password to configure all upstream archive keys, proprietary
# tile/DEM feeds, collaborator API keys, and map/terrain caches directly inside the desktop app.
HUB_ADMIN_PASSWORD=

# Optional (standalone local mode without a Hub): USGS EarthExplorer Machine-to-Machine (M2M) and
# NASA Earthdata credentials — can also be entered directly in Settings inside the desktop app.
USGS_USERNAME=
USGS_M2M_TOKEN=
EARTHDATA_TOKEN=
